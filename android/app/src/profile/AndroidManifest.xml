<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A permissão INTERNET é necessária durante o desenvolvimento.
         A ferramenta Flutter a utiliza para se comunicar com o aplicativo em execução
         e permitir pontos de interrupção, recarga de código e outros recursos.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
</manifest>
